# Objective with Pruning
def objective_v1(trial, train_loader, val_loader):
    # Fixed
    n_epochs = 20

    # Variables
    learning_rate = trial.suggest_float("learning_rate", 1e-5, 1e-1, log=True)
    n_hidden1 = trial.suggest_int("n_hidden1", 20, 300)
    n_hidden2 = trial.suggest_int("n_hidden2", 20, 100)

    # Functions
    model = ImageClassifier(28*28, n_hidden1, n_hidden2, 10).to(device)
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.SGD(model.parameters(), lr=learning_rate)

    # Training
    val_score = 0.0
    for epoch in range(n_epochs):
        model.train()
        for X_mb, y_mb in train_loader:
            X_mb = X_mb.to(device)
            y_mb = y_mb.to(device)
            y_out = model(X_mb)
            loss = criterion(y_out, y_mb)
            loss.backward()
            optimizer.step()
            optimizer.zero_grad()

        # Validation
        accuracy = Accuracy(task="multiclass", num_classes=10).to(device)
        val_score = evaluate_tm(model, val_loader, accuracy)
        trial.report(val_score, epoch)
        if trial.should_prune():
            raise optuna.TrialPruned()

    return val_score


# Optimize with Pruning
