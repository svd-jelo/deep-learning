# Define the Image Classifier
class ImageClassifier(nn.Module):
    def __init__(self, n_features, n_hidden1, n_hidden2, n_clases):
        super().__init__()
        self.model = nn.Sequential(
            nn.Flatten(),
            nn.Linear(n_features, n_hidden1), nn.ReLU(),
            nn.Linear(n_hidden1, n_hidden2), nn.ReLU(),
            nn.Linear(n_hidden2, n_clases),
        )

    def forward(self, X):
        return self.model(X)

def train_eval_mbgd(model, train_dataloader, val_dataloader, optimizer, criterion, n_epochs, device='mps'):
    training_loss = 0
    val_losses = []
    for epoch in range(n_epochs):
        model.train()
        for X_mb, y_mb in train_dataloader:
            X_mb = X_mb.to(device)
            y_mb = y_mb.to(device)
            y_out = model(X_mb)
            loss = criterion(y_out, y_mb)
            training_loss += loss.detach().item()
            loss.backward()
            optimizer.step()
            optimizer.zero_grad()

        val_losses.append(evaluate(model, val_dataloader, criterion, device=device))
        training_loss /= len(train_dataloader)
        print(f'Epoch {epoch + 1}/{n_epochs}, Loss: {training_loss}')

    return val_losses

torch.manual_seed(42)
learning_rate = 0.001
model = ImageClassifier(28*28, 300, 100, 10).to(device)
loss = nn.CrossEntropyLoss()
optimizer = torch.optim.SGD(model.parameters(), lr=learning_rate)
val_losses = {learning_rate: train_eval_mbgd(model, train_loader, val_loader, optimizer, loss, 20, device)}


# Find best LR
lrs = [7.5e-3, 2.0e-2, 4.0e-2]
for lr in lrs:
    model = ImageClassifier(28*28, 300, 100, 10).to(device)
    optimizer = torch.optim.SGD(model.parameters(), lr=lr)
    loss = nn.CrossEntropyLoss()
    print(f"\n--- Starting Training with Learning Rate: {lr} ---")
    val_losses[lr] = train_eval_mbgd(model, train_loader, val_loader, optimizer, loss, 20, device)


# Plot validation losses by LR
colors = ['blue', 'red', 'orange', 'green', 'blue', 'red', 'orange']
for color, record in zip(colors, val_losses.items()):
