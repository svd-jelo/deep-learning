# Hyperparameter tuning
def objective(trial, epochs, accuracy):
    lr = trial.suggest_float('learning_rate', 1e-5, 1e-1, log=True)
    n_hidden1 = trial.suggest_int('n_hidden1', 20, 300)
    batch_size = trial.suggest_int('batch_size', 50, 200)
    train_loader = DataLoader(train_data, batch_size=batch_size, shuffle=True)
    model = nn.Sequential(
        Dense(n_features, n_hidden1),
        Dense(n_hidden1, 100),
        nn.Linear(100, n_classes),
    ).to(device)
    loss = nn.CrossEntropyLoss()
    optimizer = torch.optim.SGD(model.parameters(), lr=lr)
    val_score = 0.0
    for epoch in range(epochs):
        model.train()
        for X_mb, y_mb in train_loader:
            X_mb, y_mb = X_mb.to(device), y_mb.to(device)
            y_out = model(X_mb)
            loss_ = loss(y_out, y_mb)
            loss_.backward()
            optimizer.step()
            optimizer.zero_grad()
        val_score = evaluate_tm(model, val_loader, accuracy)
        trial.report(val_score, epoch)
        if trial.should_prune():
            raise optuna.TrialPruned()
    return val_score

torch.manual_seed(42)
sampler = optuna.samplers.TPESampler(seed=42)
pruner = optuna.pruners.MedianPruner(n_startup_trials=3, n_warmup_steps=5, interval_steps=1)
study = optuna.create_study(study_name='cover-type-classifier',
                            direction="maximize",
                            sampler=sampler,
                            storage='sqlite:///models/cover-type-classifier-tuning.db',
                            load_if_exists=True)
study.optimize(lambda trial: objective(trial, epochs=20, accuracy=accuracy), n_trials=10)


